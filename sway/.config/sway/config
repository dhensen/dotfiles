# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term alacritty
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
#set $menu dmenu_path | dmenu | xargs swaymsg exec --
set $uifont "Ubuntu 14"
set $highlight #3daee9
set $prompt #18b218
# set $menu bemenu-run --fn $uifont -b -p "▶" --tf "$prompt" --hf "$highlight" --sf "$highlight" --scf "$highlight" | xargs swaymsg exec --
set $menu wofi --show drun | xargs swaymsg exec --

# default_border none

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg ~/Pictures/Wallpapers/wallhaven-p2odem.jpg fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# output "AU Optronics 0x243D Unknown" pos 0 0
set $laptop eDP-1
output $laptop pos 0 0
bindswitch --locked lid:on output $laptop disable
bindswitch --locked lid:off output $laptop enable

# output "Dell Inc. DELL U2715H GH85D7CM022S" pos 1920 0 scale 1
# output "Dell Inc. DELL U3223QE 7TZ7J04" pos 1920 0 scale 1.5
# output DP-4 pos 1920 0 scale 1.5
output 'LG Electronics LG HDR WQHD+ 0x01010101' pos 1920 0 scale 1
# You can get the names of your outputs by running: swaymsg -t get_outputs

# Outcommented because of issue
# See https://github.com/swaywm/sway/issues/8108
# workspace 1 output DP-4
# workspace 2 output DP-4
# workspace 3 output DP-4
# workspace 4 output DP-4
# workspace 5 output DP-4
# workspace 6 output DP-4
# workspace 7 output eDP-1
# workspace 8 output eDP-1
# workspace 9 output eDP-1

### Idle configuration
#
# Example configuration:
#
exec swayidle -w \
         timeout 300 'swaylock -f -c 000000 -i ~/screenlock.jpg' \
         timeout 600 'swaymsg "output * dpms off"' \
         resume 'swaymsg "output * dpms on"' \
         before-sleep 'swaylock -f -c 000000 -i ~/screenlock.jpg'

exec gammastep -m wayland -l 52.0685:4.5094 -t 5700:2500 -r
exec waybar
exec --no-startup-id /usr/lib/polkit-kde-authentication-agent-1

# for flameshot
# exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
# exec hash dbus-update-activation-environment 2>/dev/null && \
#      dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK
# exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

