#!/bin/bash

# Ensure xdotool is installed
if ! command -v xdotool &> /dev/null
then
    echo "xdotool could not be found. Please install it using your package manager."
    exit
fi

# Perform 10 mouse clicks
for i in {1..10}
do
    xdotool click 1
    sleep 0.2 # Adding a small delay between clicks
done

