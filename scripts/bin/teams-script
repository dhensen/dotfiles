#!/usr/bin/env bash

js='// valid mousemove “wiggle” closure: -1px, +1px
const mouseWiggle = (() => {
  let dir = -1;
  return () => {
    const el = document.body;
    const rect = el.getBoundingClientRect();
    const x = Math.floor(rect.left + rect.width / 2) + dir;
    const y = Math.floor(rect.top + rect.height / 2);

    el.dispatchEvent(new MouseEvent("mousemove", {
      bubbles: true,
      cancelable: true,
      clientX: x,
      clientY: y,
      screenX: x,
      screenY: y,
      movementX: dir,
      movementY: 0,
      buttons: 0
    }));

    dir *= -1;
  };
})();

// example
setInterval(mouseWiggle, 60000);'

# Linux (Wayland/X11)
if command -v wl-copy >/dev/null; then
  printf "%s" "$js" | wl-copy
elif command -v xclip >/dev/null; then
  printf "%s" "$js" | xclip -selection clipboard
elif command -v pbcopy >/dev/null; then
  printf "%s" "$js" | pbcopy
else
  echo "No clipboard tool found (wl-copy, xclip, pbcopy)"
  exit 1
fi

echo "JS copied to clipboard"

