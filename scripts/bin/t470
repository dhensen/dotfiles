#!/bin/bash

set -x

pkill panel
xrandr --auto
setup_monitors

if xrandr | grep -o "DP-1-1 connected"; then
	xrandr --output eDP-1 --off \
		--output DP-1 --off \
		--output HDMI-1 --off \
		--output DP-2 --off \
		--output HDMI-2 --off \
		--output DP-1-1 --primary --mode 2560x1440 --pos 1920x0 --rotate normal \
		--output DP-1-1-1 --off \
		--output DP-1-2 --mode 2560x1440 --pos 4480x0 --rotate normal --right-of DP-1-1 \
		--output DP-1-3 --off
	bspc monitor DP-1-1 -d 1 2 3 4 5
	bspc monitor DP-1-2 -d 6 7 8 9 10
fi

xset r rate 150 30
panel >panel.logs 2>&1 &
